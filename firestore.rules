rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // FN-135 training records - allow create from web app
    match /fn135_records/{docId} {
      allow read, write: if true;
    }

    // QC history is filled by the plant PC script. The Admin SDK bypasses these rules.
    match /qc_employee_history/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /qc_meta/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
